{
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "chat.editing.alwaysSaveWithGeneratedChanges": true,
    "chat.editor.fontSize": 13,
    "debug.console.historySuggestions": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.accessibilitySupport": "off",
    "editor.fontFamily": "Fira Code",
    "editor.fontLigatures": true,
    "editor.guides.highlightActiveIndentation": false,
    "editor.inlineSuggest.enabled": true,
    "editor.minimap.showSlider": "always",
    "editor.minimap.size": "fill",
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.quickSuggestionsDelay": 2,
    "editor.rulers": [
        120
    ],
    "editor.suggestSelection": "first",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "extensions.autoUpdate": "on",
    "files.associations": {
        "**/*.html": "html",
        "**/requirements{/**,*}.{txt,in}": "pip-requirements",
        "**/templates/**/*": "django-txt",
        "**/templates/**/*.html": "django-html",
        "*.uml": "plantuml"
    },
    "files.autoSave": "off",
    "files.exclude": {
        "**/__pycache__": true,
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.hg": true,
        "**/.svn": true,
        "**/CVS": true,
        "**/Thumbs.db": true,
        "**/venv": true
    },
    "git-graph.dialog.rebase.ignoreDate": false,
    "git-graph.keyboardShortcut.refresh": "UNASSIGNED",
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.ignoreLegacyWarning": true,
    "git.openRepositoryInParentFolders": "never",
    "git.suggestSmartCommit": false,
    "gitlens.mode.active": "zen",
    "gitlens.views.repositories.files.layout": "list",
    "gitlens.views.stashes.files.layout": "list",
    "indenticator.color.dark": "#aa5555",
    "indenticator.inner.showHighlight": true,
    "jupyter.askForKernelRestart": false,
    "jupyter.debugJustMyCode": false,
    "jupyter.interactiveWindow.textEditor.executeSelection": true,
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "outline.showArrays": false,
    "outline.showBooleans": false,
    "outline.showModules": false,
    "outline.showVariables": false,
    "python.languageServer": "Pylance",
    "python.testing.pytestEnabled": true,
    "pythonIndent.trimLinesWithOnlyWhitespace": true,
    "redhat.telemetry.enabled": false,
    "security.workspace.trust.untrustedFiles": "open",
    "settingsSync.ignoredExtensions": [],
    "terminal.external.osxExec": "iTerm.app",
    "terminal.integrated.fontFamily": "MesloLGS NF",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.inheritEnv": false,
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "XXX",
        "[ ]",
        "[x]",
        "REVIEW",
        "REMOVE",
        "DEPRECATED"
    ],
    "todo-tree.highlights.backgroundColourScheme": [
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "indigo",
        "violet",
        "yellow",
        "violet"
    ],
    "trailing-spaces.liveMatching": false,
    "window.customTitleBarVisibility": "auto",
    "workbench.editor.showTabs": "multiple",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.ipynb": "jupyter-notebook",
        "*.md": "vscode.markdown.editor"
    },
    "workbench.startupEditor": "newUntitledFile",
    "workbench.tree.indent": 12,
    "remote.SSH.defaultExtensions": [
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "mhutchie.git-graph"
    ],
    "remote.SSH.remotePlatform": {
        "185": "linux",
        "backstage.dev": "linux",
        "vbox": "linux",
        "fly55": "linux",
        "backstage.ut": "linux",
        "backstage.prod": "linux",
        "backstage.uat": "linux",
        "anydesk": "linux",
        "P3B": "linux",
        "P4A": "linux",
        "P3A": "linux",
        "ipc": "linux",
        "ky.a": "linux",
        "P4B": "linux",
        "hc185": "linux",
        "ky.c": "linux",
        "ct.d": "linux",
        "hc16b": "linux",
        "hc16a": "linux",
        "ky.b": "linux",
        "ctky-d": "linux",
        "ctsp-d": "linux",
        "hsp-p185": "linux",
        "ctky-a": "linux",
        "ctky-b": "linux",
        "ctsp-n15k": "linux",
        "hsp-16a": "linux",
        "hsp-16b": "linux",
        "hsp-11": "linux",
        "rpt": "linux",
        "adlink": "linux",
        "uigc-14p4b": "linux",
        "uigc-14p3b": "linux",
        "hsp-16-new": "linux",
        "ollama": "linux",
        "192.168.15.100": "linux",
        "stsp-05": "linux",
        "stsp-06": "linux",
        "uigc-14p3a": "linux",
        "uigc-14p4a": "linux",
        "stsp-07": "linux",
        "nb": "linux"
    },
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "phase",
    "editor.fontSize": 15,
    "editor.minimap.enabled": false,
    "docker.extension.enableComposeLanguageServer": false,
    "chat.mcp.gallery.enabled": true,
    "workbench.activityBar.orientation": "vertical",
    "editor.semanticTokenColorCustomizations": {},
    "claudeCode.preferredLocation": "sidebar",
    "claudeCode.enableNewConversationShortcut": true,
    "chat.commandCenter.enabled": false,
    "update.mode": "default",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "window.autoDetectColorScheme": false,
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "terminal.integrated.commandsToSkipShell": [
        "workbench.action.reloadWindow",
        "workbench.action.toggleSidebarVisibility",
        "claude-vscode.focus",
        "workbench.action.togglePanel",
        "workbench.action.toggleAuxiliaryBar",
        "workbench.action.openRecent"
    ],
    "git.detectWorktrees": true,
    "gitlens.advanced.messages": {
        "suppressGitDisabledWarning": true
    },
    "markdown-preview-enhanced.previewTheme": "atom-light.css",
    "workbench.editor.enablePreview": false,
    "markdown.preview.scrollEditorWithPreview": false,
    "markdown.preview.scrollPreviewWithEditor": false,
    "markdown-preview-enhanced.scrollSync": true,
    "gitlens.views.scm.grouped.views": {
        "commits": true,
        "branches": true,
        "remotes": true,
        "stashes": true,
        "tags": true,
        "worktrees": true,
        "contributors": true,
        "fileHistory": true,
        "repositories": true,
        "searchAndCompare": false,
        "launchpad": false
    },
    "window.newWindowProfile": "Default",
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "terminal.integrated.gpuAcceleration": "off",
    "[dart]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.rulers": [
            80
        ],
        "editor.selectionHighlight": false,
        "editor.tabCompletion": "onlySnippets",
        "editor.wordBasedSuggestions": "off"
    },
    "workbench.colorTheme": "JetBrains Darcula Theme",
    "accessibility.signals.chatResponseReceived": {
        "sound": "on"
    },
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": false,
        "csharp": true,
        "javascript": true,
        "yaml": false,
        "php": true
    },
    "github.copilot.advanced": {
        "telemetry": false
    },
    "github.copilot.chat.localeOverride": "zh-TW",
    "github.copilot.nextEditSuggestions.enabled": true,
    "settingsSync.ignoredSettings": [
        "window.zoomLevel",
        "terminal.integrated.gpuAcceleration"
    ],
    "claudeCode.hideOnboarding": true
}