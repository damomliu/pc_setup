// VS Code（Windows）keybindings。來源：Cursor keybindings.json（2026-10-04 轉換），2026-10-05 移除 Eclipse Keymap 與 Copilot chat。
// Settings Sync 依平台分開存（keybindingsPerPlatform 預設 true），這份只會同步到 windows 那份。
// 按鍵說明見 vscode-keybindings.md。
[
    // ========== 視窗 ==========
    {
        "key": "ctrl+alt+r",
        "command": "-workbench.action.terminal.runRecentCommand"
    },
    {
        "key": "ctrl+alt+r",
        "command": "-workbench.action.terminal.sendSequence"
    },
    {
        "key": "ctrl+alt+r",
        "command": "workbench.action.reloadWindow"
    },
    {
        "key": "ctrl+q",
        "command": "-workbench.action.quickOpenView"
    },
    {
        "key": "ctrl+q",
        "command": "workbench.action.closeWindow"
    },
    {
        "key": "ctrl+shift+w",
        "command": "-workbench.action.closeWindow"
    },
    {
        "key": "ctrl+shift+w",
        "command": "workbench.action.closeAllEditors"
    },
    {
        "key": "ctrl+k shift+w",
        "command": "workbench.action.closeOtherEditors"
    },
    {
        // 刻意不給 Save As 快速鍵
        "key": "ctrl+shift+s",
        "command": "-workbench.action.files.saveAs"
    },
    {
        "key": "ctrl+shift+s",
        "command": "workbench.action.files.saveAll"
    },
    {
        "key": "ctrl+k z",
        "command": "-workbench.action.toggleZenMode"
    },
    {
        "key": "ctrl+k z",
        "command": "workbench.action.toggleFullScreen"
    },

    // ========== 終端機 / 面板 / 側邊欄 ==========
    {
        "key": "ctrl+k ctrl+m",
        "command": "-workbench.action.toggleMaximizeEditorGroup"
    },
    {
        "key": "ctrl+k ctrl+m",
        "command": "workbench.action.toggleMaximizedAuxiliaryBar"
    },
    {
        "key": "ctrl+'",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+`",
        "command": "-workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+shift+'",
        "command": "workbench.action.toggleMaximizedPanel"
    },
    {
        "key": "ctrl+b",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.togglePanel",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+r",
        "command": "workbench.action.openRecent",
        "when": "terminalFocus"
    },
    {
        // 右側欄（Claude Code / Codex）；terminal 內也能用（見 settings 的 commandsToSkipShell）
        "key": "ctrl+m",
        "command": "-editor.action.toggleTabFocusMode"
    },
    {
        "key": "ctrl+m",
        "command": "workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "ctrl+0",
        "command": "-workbench.action.focusSideBar"
    },
    {
        "key": "ctrl+0",
        "command": "workbench.action.zoomReset"
    },
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001b\r"
        },
        "when": "terminalFocus"
    },

    // ========== 編輯器群組 / 分割 ==========
    {
        "key": "ctrl+k left",
        "command": "-workbench.action.moveActiveEditorGroupLeft"
    },
    {
        "key": "ctrl+k left",
        "command": "-views.moveViewLeft",
        "when": "focusedView != ''"
    },
    {
        "key": "ctrl+k right",
        "command": "-workbench.action.moveActiveEditorGroupRight"
    },
    {
        "key": "ctrl+k right",
        "command": "-views.moveViewRight",
        "when": "focusedView != ''"
    },
    {
        "key": "ctrl+k down",
        "command": "-workbench.action.moveActiveEditorGroupDown"
    },
    {
        "key": "ctrl+k up",
        "command": "-workbench.action.moveActiveEditorGroupUp"
    },
    {
        "key": "ctrl+shift+pageup",
        "command": "-workbench.action.moveEditorLeftInGroup"
    },
    {
        "key": "ctrl+shift+pagedown",
        "command": "-workbench.action.moveEditorRightInGroup"
    },
    {
        "key": "ctrl+k left",
        "command": "workbench.action.moveEditorToLeftGroup"
    },
    {
        "key": "ctrl+k right",
        "command": "workbench.action.moveEditorToRightGroup"
    },
    {
        "key": "ctrl+k down",
        "command": "workbench.action.moveEditorToBelowGroup"
    },
    {
        "key": "ctrl+k up",
        "command": "workbench.action.moveEditorToAboveGroup"
    },
    {
        "key": "ctrl+k oem_minus",
        "command": "workbench.action.splitEditorOrthogonal"
    },
    {
        "key": "ctrl+k n",
        "command": "workbench.action.moveEditorToNewWindow"
    },

    // ========== 編輯操作 ==========
    {
        "key": "ctrl+shift+backspace",
        "command": "deleteAllLeft"
    },
    {
        "key": "alt+d",
        "command": "editor.action.addSelectionToNextFindMatch",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+d",
        "command": "-editor.action.addSelectionToNextFindMatch",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+d",
        "command": "editor.action.deleteLines",
        "when": "textInputFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+k",
        "command": "-editor.action.deleteLines",
        "when": "textInputFocus && !editorReadonly"
    },
    {
        "key": "ctrl+u",
        "command": "-cursorUndo",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+1",
        "command": "editor.action.quickFix",
        "when": "editorHasCodeActionsProvider && textInputFocus && !editorReadonly"
    },
    {
        "key": "shift+f8",
        "command": "-editor.action.marker.prevInFiles",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+alt+j",
        "command": "editor.action.joinLines"
    },
    {
        "key": "shift+enter",
        "command": "editor.action.insertLineAfter",
        "when": "editorTextFocus && !editorReadonly && !findInputFocussed && !replaceInputFocussed"
    },

    // ========== 尋找 ==========
    {
        "key": "f3",
        "command": "-editor.action.nextMatchFindAction",
        "when": "editorFocus"
    },
    {
        "key": "shift+enter",
        "command": "editor.action.previousMatchFindAction",
        "when": "editorFocus && findInputFocussed"
    },
    {
        "key": "ctrl+e",
        "command": "-workbench.action.quickOpen"
    },

    // ========== 導覽（定義 / 實作 / 參考） ==========
    {
        "key": "f3",
        "command": "editor.action.goToDeclaration"
    },
    {
        "key": "f12",
        "command": "-editor.action.revealDefinition",
        "when": "editorHasDefinitionProvider && editorTextFocus && !isInEmbeddedEditor"
    },
    {
        "key": "f12",
        "command": "editor.action.goToReferences",
        "when": "editorHasReferenceProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"
    },
    {
        "key": "shift+f12",
        "command": "-editor.action.goToReferences",
        "when": "editorHasReferenceProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"
    },
    {
        // Cursor 用 glass.editor.action.findImplementationsInSidebar
        "key": "shift+f12",
        "command": "editor.action.goToImplementation",
        "when": "editorHasImplementationProvider && editorTextFocus && !isInEmbeddedEditor"
    },
    {
        "key": "ctrl+f12",
        "command": "-editor.action.goToImplementation",
        "when": "editorHasImplementationProvider && editorTextFocus && !isInEmbeddedEditor"
    },
    {
        "key": "alt+f12",
        "command": "-editor.action.peekDefinition",
        "when": "editorHasDefinitionProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"
    },
    {
        "key": "alt+f12",
        "command": "editor.action.peekImplementation",
        "when": "editorHasImplementationProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"
    },
    {
        "key": "ctrl+shift+f12",
        "command": "-editor.action.peekImplementation",
        "when": "editorHasImplementationProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"
    },

    // ========== 字型縮放 ==========
    {
        "key": "ctrl+shift+oem_plus",
        "command": "editor.action.fontZoomIn"
    },
    {
        "key": "ctrl+shift+oem_minus",
        "command": "editor.action.fontZoomOut"
    },
    {
        "key": "ctrl+shift+9",
        "command": "editor.action.fontZoomReset"
    },

    // ========== 偵錯 ==========
    {
        "key": "f11",
        "command": "workbench.action.debug.start",
        "when": "debuggersAvailable && debugState == 'inactive'"
    },
    {
        "key": "f5",
        "command": "-workbench.action.debug.start",
        "when": "debuggersAvailable && debugState == 'inactive'"
    },
    {
        "key": "ctrl+f11",
        "command": "workbench.action.debug.selectandstart"
    },
    {
        "key": "f8",
        "command": "workbench.action.debug.continue",
        "when": "inDebugMode"
    },
    {
        "key": "ctrl+f2",
        "command": "workbench.action.debug.stop",
        "when": "inDebugMode"
    },
    {
        "key": "ctrl+f10",
        "command": "editor.debug.action.runToCursor"
    },
    {
        "key": "ctrl+y",
        "command": "-redo"
    },
    {
        "key": "ctrl+y",
        "command": "editor.debug.action.selectionToRepl",
        "when": "inDebugMode && editorTextFocus"
    },
    {
        "key": "ctrl+u",
        "command": "editor.debug.action.selectionToWatch",
        "when": "inDebugMode && editorTextFocus"
    },
    {
        "key": "ctrl+k ctrl+d",
        "command": "workbench.action.debug.callStackTop"
    },
    {
        "key": "ctrl+shift+y",
        "command": "workbench.debug.action.toggleRepl",
        "when": "workbench.panel.repl.view.active"
    },
    {
        "key": "ctrl+shift+alt+y",
        "command": "-workbench.debug.action.toggleRepl",
        "when": "workbench.panel.repl.view.active"
    },

    // ========== Git / SCM ==========
    {
        "key": "ctrl+k ctrl+g",
        "command": "git-graph.view"
    },
    {
        "key": "ctrl+shift+j",
        "command": "workbench.view.scm",
        "when": "workbench.scm.active"
    },
    {
        "key": "ctrl+shift+g",
        "command": "-workbench.view.scm",
        "when": "workbench.scm.active"
    },
    {
        "key": "ctrl+shift+alt+o",
        "command": "git.openWorktreeInNewWindow"
    },

    // ========== Markdown ==========
    {
        "key": "alt+b",
        "command": "markdown.extension.editing.toggleBold",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },
    {
        "key": "ctrl+b",
        "command": "-markdown.extension.editing.toggleBold",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },
    {
        "key": "alt+i",
        "command": "markdown.extension.editing.toggleItalic",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },
    {
        "key": "ctrl+i",
        "command": "-markdown.extension.editing.toggleItalic",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },
    {
        "key": "alt+m",
        "command": "markdown.extension.editing.toggleMath",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },
    {
        "key": "ctrl+m",
        "command": "-markdown.extension.editing.toggleMath",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },
    {
        "key": "shift+enter",
        "command": "-markdown.extension.onShiftEnterKey",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/ && (!suggestWidgetVisible || config.editor.acceptSuggestionOnEnter == 'off') && !editorHasMultipleSelections && !markdown.extension.editor.cursor.inFencedCodeBlock && !markdown.extension.editor.cursor.inMathEnv"
    },
    {
        "key": "shift+enter",
        "command": "markdown.extension.onShiftEnterKey",
        "when": "editorTextFocus && !editorReadonly && !findInputFocussed && !replaceInputFocussed && editorLangId =~ /^markdown$|^rmd$|^quarto$/ && (!suggestWidgetVisible || config.editor.acceptSuggestionOnEnter == 'off') && !editorHasMultipleSelections && !markdown.extension.editor.cursor.inFencedCodeBlock && !markdown.extension.editor.cursor.inMathEnv"
    },
    {
        "key": "ctrl+k v",
        "command": "-markdown.showPreviewToSide",
        "when": "!notebookEditorFocused && editorLangId == 'markdown'"
    },
    {
        "key": "ctrl+k shift+v",
        "command": "markdown-preview-enhanced.openLockedPreviewToTheSide",
        "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
    },
    {
        "key": "ctrl+k shift+l",
        "command": "-markdown-preview-enhanced.openLockedPreviewToTheSide",
        "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
    },
    {
        "key": "ctrl+alt+m",
        "command": "markdown-preview-enhanced.toggleScrollSync"
    },
    {
        "key": "ctrl+shift+enter",
        "command": "-markdown-preview-enhanced.runAllCodeChunks",
        "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
    },
    {
        "key": "shift+enter",
        "command": "-markdown-preview-enhanced.runCodeChunk",
        "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
    },
    {
        "key": "f5",
        "command": "markdown.preview.refresh",
        "when": "editorLangId == 'markdown' || activeWebviewPanelId == 'markdown.preview'"
    },

    // ========== Claude Code ==========
    {
        // 不加 when：editor 與 terminal（見 settings 的 commandsToSkipShell）都能用
        "key": "ctrl+l",
        "command": "claude-vscode.focus"
    },
    {
        // 焦點已在 Claude Code 時改為回到 editor，讓 Ctrl+L 成為 toggle；放在 focus 之後才會優先。
        // webview 不會設 focusedView，改用 extension 自己判斷新對話快速鍵的條件（sideBarActive = Claude sidebar 可見）
        "key": "ctrl+l",
        "command": "claude-vscode.blur",
        "when": "(claude-vscode.sideBarActive && !editorFocus && !panelFocus && !sideBarFocus) || (activeWebviewPanelId == 'claudeVSCodePanel' && !panelFocus && !sideBarFocus && !auxiliaryBarFocus)"
    },
    {
        // 取代內建 Ctrl+Shift+Esc（Windows 會攔去開工作管理員）
        "key": "ctrl+shift+alt+l",
        "command": "claude-vscode.editor.open"
    },
    {
        // 內建 Alt+K 被 AutoHotkey（damon.ahk 的 !k → ↑）攔走；Ctrl+Alt+K 原本是送到 terminal CLI 的 insertAtMentioned，不用；@-mention 改用 Ctrl+Alt+L
        "key": "ctrl+alt+k",
        "command": "-claude-code.insertAtMentioned",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+alt+l",
        "command": "claude-vscode.insertAtMention",
        "when": "editorTextFocus"
    },
    {
        "key": "alt+k",
        "command": "-claude-vscode.insertAtMention",
        "when": "editorTextFocus"
    },

    // ========== Codex ==========
    {
        // 留給 Codex webview 內建的 model picker
        "key": "ctrl+shift+m",
        "command": "-workbench.actions.view.problems"
    },
    {
        "key": "ctrl+o",
        "command": "-workbench.action.files.openFile"
    },
    {
        // 不加進 settings 的 commandsToSkipShell，terminal 內的 Ctrl+O 留給 Claude Code／Codex CLI（Claude CLI 用它開 transcript）
        "key": "ctrl+o",
        "command": "chatgpt.openSidebar"
    },
    {
        "key": "ctrl+alt+o",
        "command": "chatgpt.addToThread",
        "when": "editorTextFocus"
    },

    // ========== VS Code 內建 chat 解除綁定 ==========
    {
        "key": "ctrl+shift+i",
        "command": "-workbench.action.chat.openagent"
    },
    {
        "key": "ctrl+alt+i",
        "command": "-workbench.action.chat.open"
    },
    {
        "key": "ctrl+shift+alt+l",
        "command": "-workbench.action.quickchat.toggle"
    },
    {
        "key": "ctrl+i",
        "command": "-inlineChat.start"
    },
    {
        "key": "ctrl+i",
        "command": "-inlineChat.askInChat"
    },
    {
        "key": "ctrl+i",
        "command": "-notebook.cell.chat.start"
    },
    {
        "key": "ctrl+i",
        "command": "-workbench.action.terminal.chat.start"
    },

    // ========== 其他擴充 ==========
    {
        "key": "ctrl+k e",
        "command": "edit-csv.edit"
    },
    {
        "key": "ctrl+k m",
        "command": "-notebook.cell.changeLanguage",
        "when": "notebookCellEditable && notebookEditable && notebookEditorFocused"
    }
]
