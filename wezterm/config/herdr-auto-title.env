# Auto Title (kryptamine/herdr-auto-title) config.env
# Windows: %USERPROFILE%\.config\herdr-auto-title\config.env
# WSL:     ~/.config/herdr-auto-title/config.env
HERDR_AUTO_TITLE_PANES=false
HERDR_AUTO_TITLE_AGENT_STATUS=true
HERDR_AUTO_TITLE_PREFER_AGENT=true
HERDR_AUTO_TITLE_ICONS=false
HERDR_AUTO_TITLE_BRANCH_MAX=0
HERDR_AUTO_TITLE_DIRECTORY_MAX=0
